{
  "name": "agent-transcripts",
  "version": "0.0.1",
  "description": "Capture coding-agent transcripts to disk and expose them as SQL.",
  "license": "MIT",
  "repository": "https://github.com/thekevinscott/agent-transcripts",
  "type": "module",
  "bin": {
    "agent-transcripts": "dist/bin.js"
  },
  "files": [
    "dist/",
    "changelog.d/",
    "migrations.d/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
